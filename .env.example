# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
DATABASE_URL=postgres://bb:change-me@localhost:5432/betterbattle
REDIS_URL=redis://localhost:6379
HYPIXEL_API_KEY=            # from https://developer.hypixel.net
HYPIXEL_RATE=280            # requests per 5 minutes, stay under your key's limit
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=          # optional bot token; never share this value
DISCORD_GUILD_ID=           # Discord server ID for instant slash-command registration
PUBLIC_URL=http://localhost:4000      # site origin; Discord callback is /bb/v1/auth/discord/callback
SESSION_SECRET=             # any long random string
ADMIN_TOKEN=               # long random string; unlocks /admin.html (only you should know it)
# Optional overrides for the mod download release and verified jar cache.
# MOD_RELEASE_REPO=Koiduu/BetterBuildbattle
# MOD_CACHE_DIR=/var/cache/betterbattle-mod
# Optional second copy of database backups (for example, a OneDrive folder on Windows).
# BACKUP_COPY_DIR=C:\Users\you\OneDrive\BetterBattle-backups

# ---- Paid plans (optional). Leave empty and the Plans page shows "Coming soon".
# Setup steps: docs/plans-setup.md
STRIPE_SECRET_KEY=          # sk_live_... (or sk_test_... while testing); never share this value
STRIPE_WEBHOOK_SECRET=      # whsec_... from the webhook endpoint you add in Stripe
STRIPE_PRICE_ARCHITECT=     # price_... of the Architect monthly price
STRIPE_PRICE_MASTER=        # price_... of the Master Builder monthly price
STRIPE_AUTOMATIC_TAX=       # 1 to let Stripe Tax work out VAT/sales tax (needs Stripe Tax switched on)
DISCORD_ROLE_ARCHITECT=     # optional Discord role ID given to Architect and Master Builder supporters
DISCORD_ROLE_MASTER=        # optional Discord role ID given to Master Builder supporters
