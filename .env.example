# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
DATABASE_URL=postgres://bb:change-me@localhost:5432/betterbattle
REDIS_URL=redis://localhost:6379
HYPIXEL_API_KEY=            # from https://developer.hypixel.net
HYPIXEL_RATE=280            # requests per 5 minutes, stay under your key's limit
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=             # any long random string
ADMIN_TOKEN=               # long random string; unlocks /admin.html (only you should know it)
